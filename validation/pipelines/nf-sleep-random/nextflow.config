// Run against the local-cluster. Set NOMAD_ADDR and NOMAD_TOKEN in the environment.
plugins { id 'nf-nomad' }

process {
    executor = 'nomad'
    // Small footprint so many tasks are in flight at once — that is what gives the
    // chaos trial a populated cluster to disrupt.
    cpus   = 1
    memory = '256 MB'
}

nomad {
    client {
        address = System.getenv('NOMAD_ADDR') ?: 'http://127.0.0.1:4646'
        token   = System.getenv('NOMAD_TOKEN')
    }
    jobs {
        deleteOnCompletion = false   // keep allocations inspectable after a trial
    }
}
