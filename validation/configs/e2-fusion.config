/*
 * E2 mode — Fusion file system + Wave (Nomad executor, S3 work dir).
 *
 * Fusion presents the S3 work dir to tasks as a POSIX mount; Wave augments the
 * container images at run time. Compared against the s5cmd mode (e2-s5cmd.config)
 * for OUTPUT EQUIVALENCE across work-dir modes (handover E2). Multi-node — S3 is
 * the shared layer, so no single-node pin.
 *
 * Run for BOTH pipelines (mtbseq-nf and taxprofiler). Work dir MUST be an s3://
 * URI:  RUN_TAG=e2-fusion-<pipeline> nextflow run <pipeline> \
 *         -c e2-fusion.config -w s3://<bucket>/work-e2-fusion -profile <container> ...
 *
 * Uses the strict-parser syntax from upstream PR #132. Verified against
 * nf-nomad 0.5.0-edge3 / Nextflow 26.04.3.
 *
 * Secrets are Nextflow secrets (never inline): set once with
 *   nextflow secrets set NF_VALIDATION_S3_ACCESS_KEY <key>
 *   nextflow secrets set NF_VALIDATION_S3_SECRET_KEY <secret>
 * Endpoint + Nomad wiring come from the environment (campaign.env.example).
 */

includeConfig 'nextflow.trace.config'

plugins {
    id "nf-nomad@${System.getenv('NOMAD_PLUGIN_VERSION') ?: '0.5.0-edge3'}"
}

process { executor = 'nomad' }

wave   { enabled = true }
fusion { enabled = true; exportStorageCredentials = true }

aws {
    accessKey = secrets.NF_VALIDATION_S3_ACCESS_KEY
    secretKey = secrets.NF_VALIDATION_S3_SECRET_KEY
    client { endpoint = System.getenv('NF_S3_ENDPOINT') }
}

nomad {
    client { address = System.getenv('NOMAD_ADDR') }
    jobs {
        namespace  = System.getenv('NOMAD_NAMESPACE') ?: 'default'
        nodePool   = System.getenv('NOMAD_NODE_POOL')
        taskDriver = 'docker'
        deleteOnCompletion = false
        // Agents commonly disable Docker privileged mode; nf-nomad asks for it
        // by default and task creation then fails outright.
        privileged = false
        // Fail fast rather than hanging forever on an unplaceable task job.
        failOnPlacementFailure = true
        secrets { enabled = true }
    }
}
