/*
 * nextflow.trace.config — execution-trace capture, included by EVERY arm/mode.
 *
 * A run without these is a run that must be repeated (handover §4): X1 walltime,
 * X4 placement latency (start − submit), and per-task distribution all derive
 * from execution_trace.txt. RUN_TAG (env) namespaces the files per arm/mode so a
 * campaign's runs never overwrite each other.
 */

def _tag = System.getenv('RUN_TAG') ?: 'run'
def _dir = params.tracedir ?: 'pipeline_info'

trace {
    enabled   = true
    overwrite = true
    file      = "${_dir}/execution_trace-${_tag}.txt"
    // native_id + submit/start/complete are what X4 needs (placement latency);
    // realtime/%cpu/peak_rss characterise per-task cost across substrates.
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
report   { enabled = true; overwrite = true; file = "${_dir}/execution_report-${_tag}.html" }
timeline { enabled = true; overwrite = true; file = "${_dir}/execution_timeline-${_tag}.html" }
dag      { enabled = true; overwrite = true; file = "${_dir}/pipeline_dag-${_tag}.mmd" }
