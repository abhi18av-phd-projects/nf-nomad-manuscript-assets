/*
 * E2 mode — nf-nomad-s5cmd + S3 (Nomad executor, S3 work dir).
 *
 * s5cmd stages each task's I/O to/from S3 — the plugin's native S3 work-dir mode,
 * no Fusion/Wave. Compared against the Fusion mode (e2-fusion.config) for OUTPUT
 * EQUIVALENCE across work-dir modes (handover E2). Multi-node — S3 is the shared
 * layer.
 *
 * Run for BOTH pipelines (mtbseq-nf and taxprofiler). Work dir MUST be an s3://
 * URI:  RUN_TAG=e2-s5cmd-<pipeline> nextflow run <pipeline> \
 *         -c e2-s5cmd.config -w s3://<bucket>/work-e2-s5cmd -profile <container> ...
 *
 * Uses the strict-parser syntax from upstream PR #132. Verified against
 * nf-nomad 0.5.0-edge3 / Nextflow 26.04.3.
 *
 * The s5cmd binary is provided to tasks by a mounted host volume; its in-task path
 * and the volume name are site-specific (env), so this config stays generic.
 */

includeConfig 'nextflow.trace.config'

plugins {
    id "nf-nomad@${System.getenv('NOMAD_PLUGIN_VERSION') ?: '0.5.0-edge3'}"
}

process { executor = 'nomad' }

aws {
    accessKey = secrets.NF_VALIDATION_S3_ACCESS_KEY
    secretKey = secrets.NF_VALIDATION_S3_SECRET_KEY
    client { endpoint = System.getenv('NF_S3_ENDPOINT') }
}

nomad {
    client { address = System.getenv('NOMAD_ADDR') }
    jobs {
        namespace  = System.getenv('NOMAD_NAMESPACE') ?: 'default'
        nodePool   = System.getenv('NOMAD_NODE_POOL')
        taskDriver = 'docker'
        deleteOnCompletion = false
        // Agents commonly disable Docker privileged mode; nf-nomad asks for it
        // by default and task creation then fails outright.
        privileged = false
        // Fail fast rather than hanging forever on an unplaceable task job.
        failOnPlacementFailure = true
        // Host volume carrying the s5cmd binary, mounted read-only into tasks.
        volumes = [
            [type: "host", name: (System.getenv('NOMAD_TOOLS_VOLUME') ?: 'tools')],
        ]
    }
    s5cmd {
        binary = System.getenv('NF_S5CMD_BINARY') ?: '/opt/tools/bin/s5cmd'
    }
}
