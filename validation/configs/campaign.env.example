# campaign.env.example — copy to campaign.env (gitignored), fill, then `source` it
# before each run. Site-specific values only; the .config files stay generic.
# NOTHING secret belongs in a committed file — tokens/keys go here (untracked) or
# in `nextflow secrets`.

# ── Plugin + Nextflow version (pin ONCE for the whole campaign; never mix) ──────
export NOMAD_PLUGIN_VERSION=0.5.0-edge3      # public on registry.nextflow.io
export NXF_VER=26.04.3                        # nf-nomad >= 0.4.4 requires NXF >= 26.04.3

# ── Nomad API (X1 arm B, X2, X3) ────────────────────────────────────────────────
export NOMAD_ADDR=                            # e.g. https://<nomad-api-host>
export NOMAD_TOKEN=                           # ACL token (SECRET — keep this file untracked)
export NOMAD_NAMESPACE=default

# ── X1 arm B: single-node shared-POSIX work dir ─────────────────────────────────
export NOMAD_TARGET_NODE=nomad02              # the ONE node both X1 arms run on
export NOMAD_WORK_VOLUME=nf-work              # registered host_volume for the work dir
export NODE_CPUS=24                           # target node size → resourceLimits (both arms)
export NODE_MEM_GB=20

# ── X2: S3 work dir (Fusion + s5cmd modes) ──────────────────────────────────────
export NF_S3_ENDPOINT=                        # S3 API endpoint for the work-dir bucket
export NOMAD_TOOLS_VOLUME=tools               # host_volume carrying the s5cmd binary (site-specific)
export NF_S5CMD_BINARY=/opt/tools/bin/s5cmd   # in-task path to s5cmd (site-specific)
# S3 credentials go in Nextflow secrets, NOT here:
#   nextflow secrets set NF_VALIDATION_S3_ACCESS_KEY <key>
#   nextflow secrets set NF_VALIDATION_S3_SECRET_KEY <secret>

# ── Driver (handover §4: exec hangs on some kernels — Landlock) ─────────────────
# Record the driver actually used in the environment profile (S1). raw_exec or
# docker where exec/exec2 hang.
export NF_NOMAD_DRIVER=raw_exec
