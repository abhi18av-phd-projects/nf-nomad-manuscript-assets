/*
 * X1 arm B — Nextflow + nf-nomad, SINGLE node, shared-POSIX host-volume work dir.
 *
 * Same pipeline, data, and hardware as arm A; the ONLY changed variable is the
 * execution substrate (Nomad vs local). Pinning every task to ONE node keeps the
 * Nextflow head and the task allocations on the same filesystem, so the work dir
 * is genuinely shared POSIX (this cluster has no NFS across nodes) and the
 * hardware matches arm A exactly. Multi-node distribution is demonstrated
 * separately in X2/X3, where an S3 work dir is the honest shared layer.
 *
 * All site-specific values come from the environment (see campaign.env.example)
 * so this config is generic and publishable:
 *   NOMAD_ADDR, NOMAD_TOKEN          — Nomad API endpoint + ACL token (standard)
 *   NOMAD_NAMESPACE                  — Nomad namespace (default: "default")
 *   NOMAD_WORK_VOLUME                — registered host_volume backing the work dir
 *   NOMAD_TARGET_NODE                — the single node to pin to
 *   NOMAD_PLUGIN_VERSION             — pinned once per campaign
 *
 *   RUN_TAG=x1-armB nextflow run <pipeline> \
 *     -c x1-armB-nomad-posix.config -w <host-volume-mount>/work-armB -profile <container> ...
 */

includeConfig 'nextflow.trace.config'

plugins {
    id "nf-nomad@${System.getenv('NOMAD_PLUGIN_VERSION') ?: '0.5.0-edge3'}"
}

process {
    executor = 'nomad'
    resourceLimits = [
        cpus:   (System.getenv('NODE_CPUS')   ?: '24') as int,
        memory: "${System.getenv('NODE_MEM_GB') ?: '20'}.GB",
        time:   '24.h',
    ]
}

nomad {
    client {
        // Address from NOMAD_ADDR; ACL token from NOMAD_TOKEN (Nomad-standard env).
        address = System.getenv('NOMAD_ADDR')
    }
    jobs {
        namespace          = System.getenv('NOMAD_NAMESPACE') ?: 'default'
        deleteOnCompletion = false
        // Shared-POSIX work dir: a registered host volume, mounted into every task.
        volume = { type "host" name (System.getenv('NOMAD_WORK_VOLUME') ?: 'nf-work') }
        // Single-node pin: head + tasks share one filesystem, hardware == arm A.
        constraints = {
            attr {
                node {
                    unique = [name: System.getenv('NOMAD_TARGET_NODE') ?: 'nomad02']
                }
            }
        }
    }
}
