/*
 * X1 arm B — Nextflow + nf-nomad, SINGLE node, shared-POSIX host-volume work dir.
 *
 * Same pipeline, data, and hardware as arm A; the ONLY changed variable is the
 * execution substrate (Nomad vs local). Pinning every task to ONE node keeps the
 * Nextflow head and the task allocations on the same filesystem, so the work dir
 * is genuinely shared POSIX and the hardware matches arm A exactly. Multi-node
 * distribution is demonstrated separately in X2/X3, where S3 is the shared layer.
 *
 * VERIFIED 2026-08-06 against nf-nomad 0.5.0-edge3 / Nextflow 26.04.3 by running
 * nextflow-io/rnaseq-nf (4/4 tasks) and nf-core/demo (8/8 tasks) to completion.
 *
 * Uses the STRICT-config-parser syntax that nf-nomad adopted in upstream PR #132
 * ("upgrade to nextflow 26.04.3", merged 2026-06-07): volumes as a list of map
 * literals and `constraints { ... }` as a block. The older Groovy closure DSL
 * (`volume = { type "host" name "x" }`) does NOT parse under Nextflow 26.x and
 * needed the deprecated `NXF_SYNTAX_PARSER=v1` fallback — no longer required.
 *
 * Site-specific values come from the environment (campaign.env.example):
 *   NOMAD_ADDR, NOMAD_TOKEN   — Nomad API endpoint + ACL token (Nomad-standard).
 *                               Point this at the cluster's private/VPN address
 *                               (e.g. a Tailscale IP) rather than a public edge:
 *                               fewer hops, and it is the interface Nomad binds.
 *   NOMAD_NAMESPACE           — Nomad namespace (default: "default")
 *   NOMAD_NODE_POOL           — node pool the task jobs land in. MUST be set to a
 *                               pool that has nodes; an unset pool means the
 *                               scheduler evaluates 0 nodes and jobs hang pending
 *                               with no error.
 *   NOMAD_WORK_VOLUME         — registered host_volume backing the work dir
 *   NOMAD_WORK_MOUNT          — where that volume is mounted inside tasks; the
 *                               Nextflow work dir (-w) must live under it
 *   NOMAD_TARGET_NODE         — the single node both arms run on
 *
 *   RUN_TAG=x1-armB nextflow run <pipeline> \
 *     -c x1-armB-nomad-posix.config -w <NOMAD_WORK_MOUNT>/work-armB ...
 */

includeConfig 'nextflow.trace.config'

plugins {
    id "nf-nomad@${System.getenv('NOMAD_PLUGIN_VERSION') ?: '0.5.0-edge3'}"
}

process {
    executor = 'nomad'
    resourceLimits = [
        cpus:   (System.getenv('NODE_CPUS')   ?: '8') as int,
        memory: "${System.getenv('NODE_MEM_GB') ?: '16'}.GB",
        time:   '24.h',
    ]
}

nomad {
    client {
        // Address from NOMAD_ADDR; ACL token from NOMAD_TOKEN (Nomad-standard env).
        address = System.getenv('NOMAD_ADDR')
    }
    jobs {
        namespace  = System.getenv('NOMAD_NAMESPACE') ?: 'default'
        nodePool   = System.getenv('NOMAD_NODE_POOL')
        taskDriver = 'docker'
        deleteOnCompletion = false

        // Many Nomad agents disable Docker privileged mode (a sane hardening
        // default). nf-nomad requests it unless told otherwise, which fails task
        // creation with "Docker privileged mode is disabled on this Nomad agent".
        privileged = false

        // Fail fast instead of hanging forever when a task job cannot be placed.
        failOnPlacementFailure = true

        // Shared-POSIX work dir: one registered host volume, mounted at the same
        // path in the head job and every task job, so paths agree on both sides.
        volumes = [
            [type   : "host",
             name   : (System.getenv('NOMAD_WORK_VOLUME') ?: 'nf-work'),
             path   : (System.getenv('NOMAD_WORK_MOUNT') ?: '/work'),
             workDir: true],
        ]

        // Single-node pin: head + tasks share one filesystem, hardware == arm A.
        constraints {
            node {
                unique = [name: System.getenv('NOMAD_TARGET_NODE')]
            }
        }
    }
}
