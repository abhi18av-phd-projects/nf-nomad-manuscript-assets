/*
 * X1 arm A — Nextflow LOCAL executor (no Nomad).
 *
 * The substrate-neutrality comparator (handover X1, the load-bearing experiment).
 * Identical pipeline, data, and HARDWARE as arm B; the ONLY difference is the
 * execution substrate. Run this on the SAME single node as arm B — "same hardware
 * or the comparison is void" (handover §4).
 *
 * Genuinely Nomad-free: a plain `nextflow run` with the local executor, NOT a
 * single-node Nomad job (handover X1 design check).
 *
 *   RUN_TAG=x1-armA nextflow run <pipeline> \
 *     -c x1-armA-local.config -w ./work-armA -profile <container> ...
 */

includeConfig 'nextflow.trace.config'

process {
    executor = 'local'
    // Hold the resource ceiling identical to arm B so the two arms are comparable.
    // Env-driven to the target node's size (e.g. 24 cores / 20 GB with headroom).
    resourceLimits = [
        cpus:   (System.getenv('NODE_CPUS')   ?: '24') as int,
        memory: "${System.getenv('NODE_MEM_GB') ?: '20'}.GB",
        time:   '24.h',
    ]
}
