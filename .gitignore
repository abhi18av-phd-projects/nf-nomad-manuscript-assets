# ── Hard blocks. This repo is published to Zenodo; nothing below may ever enter it.
# Credentials
id_*
*.pem
*.key
*.p12
.env
.envrc
*credentials*
*.tfvars

# Pulumi / Terraform state and local backends
.pulumi/
Pulumi.*.yaml.bak
*.tfstate
*.tfstate.*
.terraform/
MANIFEST-*
LOCK
CURRENT
LOG
*.ldb
*.sst

# Build noise
node_modules/
.DS_Store
*.log
.tmp-*

# Untracked per-run site values (real Nomad addr/token, node names)
validation/configs/campaign.env

# Live Nomad ACL tokens from a local test cluster — MUST never reach this repo
# (it is published to Zenodo). Generated at runtime by the local-cluster harness.
templates/local-docker/.nomad-token
templates/local-docker/.bootstrap.json
**/.nomad-token
**/.bootstrap.json
