/*
 * Usage
 *   nextflow run nextflow-io/hello -c nextflow.gcp.config -profile hello
 *   nextflow run nextflow-io/rnaseq-nf -c nextflow.gcp.config -profile docker,rnaseq_nf
 */

def gcpDomain = System.getenv("GCP_CLUSTER_DOMAIN") ?: "dev.<YOUR_DOMAIN>"
def gcpNomadAddr = System.getenv("NOMAD_ADDR") ?: "https://${gcpDomain}"
def gcpNomadToken = System.getenv("NOMAD_TOKEN") ?: ""
def gcpMinioEndpoint = System.getenv("NF_MINIO_ENDPOINT") ?: "http://10.0.2.3:9000"
def gcpWorkDir = System.getenv("NXF_WORK_DIR") ?: "/work/nextflow-work"
def gcpOutputDir = System.getenv("NF_OUTPUT_DIR") ?: "s3://user-output/nextflow"
def minioAccessKey = System.getenv("AWS_ACCESS_KEY_ID") ?: System.getenv("MINIO_ROOT_USER") ?: "minioadmin"
def minioSecretKey = System.getenv("AWS_SECRET_ACCESS_KEY") ?: System.getenv("MINIO_ROOT_PASSWORD") ?: "minioadmin"

plugins {
    id "nf-nomad@${System.getenv("NOMAD_PLUGIN_VERSION") ?: "99.99.99"}"
    id "nf-rclone@${System.getenv("RCLONE_PLUGIN_VERSION") ?: "99.99.99"}"
}

docker {
    enabled = true
}

aws {
    client {
        endpoint = gcpMinioEndpoint
        s3PathStyleAccess = true
        protocol = "https"
    }
    accessKey = minioAccessKey
    secretKey = minioSecretKey
}

process {
    executor = "nomad"
    //shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'retry'
    maxRetries = 1

    withLabel:process_low {
        cpus = 1
        memory = "2 GB"
        maxForks = 2
        nomadOptions = [
            priority : 'low',
            resources: [memoryMax: '2 GB'],
            meta     : [env: 'gcp', tier: 'low']
        ]
    }

    withLabel:process_medium {
        cpus = 1
        memory = "4 GB"
        maxForks = 1
        nomadOptions = [
            priority : 'normal',
            resources: [memoryMax: '6 GB'],
            meta     : [env: 'gcp', tier: 'medium']
        ]
    }
}

workDir = System.getenv("NXF_WORK_DIR") ?: "s3://work/nextflow-work"

nomad {
    client {
        address = gcpNomadAddr
        token = gcpNomadToken
        pollInterval = "2s"
        submitThrottle = "100ms"
    }

    jobs {
        failOnPlacementFailure = true
        placementFailureTimeout = "5m"
        cleanup = "never"
        deleteOnCompletion = false
        cpuMode = "cores"
        meta = [env: 'gcp', stack: 'nomad-cluster']
        volumes = [[type: "host", name: "nextflow-work", path: "${gcpWorkDir}"]]
        failures = [
            restart   : [attempts: 1, mode: 'fail'],
            reschedule: [attempts: 1]
        ]
    }
}

rclone {
    enabled = true
    remotes {
        'gcp-minio' {
            type            = 's3'
            provider        = 'Minio'
            endpoint        = gcpMinioEndpoint
            accessKeyId     = minioAccessKey
            secretAccessKey = minioSecretKey
        }
    }
    pathMapping = [
        's3://work'       : 'gcp-minio',
        's3://user-input' : 'gcp-minio',
        's3://user-output': 'gcp-minio'
    ]
    rcloneWorkDir {
        enabled      = true
        remote       = 'gcp-minio'
        remotePath   = 'work/nextflow-work'
        configDelivery = 'hostPath'
        syncBack     = 'all'
        legalTransfer {
            enabled = (System.getenv("LEGAL_TRANSFER_ENABLED") ?: "false").toBoolean()
            policyServiceUrl = System.getenv("LEGAL_TRANSFER_POLICY_URL") ?: "http://127.0.0.1:8080/v1/transfer/validate"
            failOpen = (System.getenv("LEGAL_TRANSFER_FAIL_OPEN") ?: "true").toBoolean()
            timeoutMillis = (System.getenv("LEGAL_TRANSFER_TIMEOUT_MS") ?: "5000") as int
        }
    }
}

profiles {
    hello {
        params {
            outdir = "${gcpOutputDir}/hello"
        }
        process {
            cpus = 1
            memory = "1 GB"
            time = "30m"
        }
/*
        wave {
		  enabled = true
        }

        fusion {
		  enabled = true
        }
*/
    }

    rnaseq_nf {
        params {
            reads = System.getenv("RNASEQ_READS") ?: "https://raw.githubusercontent.com/nextflow-io/rnaseq-nf/master/data/ggal/*_{1,2}.fq"
            transcriptome = System.getenv("RNASEQ_TRANSCRIPTOME") ?: "https://raw.githubusercontent.com/nextflow-io/rnaseq-nf/master/data/ggal/transcript.fa"
            outdir = System.getenv("RNASEQ_OUTDIR") ?: "${gcpOutputDir}/rnaseq-nf"
        }

        process {
            cpus = 2
            memory = "4 GB"
            time = "12h"
        }
    }
}
