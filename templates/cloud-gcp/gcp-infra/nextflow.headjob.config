/*
 * Head-job config: run Nextflow inside Nomad so task jobs share the client host volume.
 */

def gcpDomain = System.getenv("GCP_CLUSTER_DOMAIN") ?: "dev.<YOUR_DOMAIN>"
def gcpNomadAddr = System.getenv("NOMAD_ADDR") ?: "https://nomad.${gcpDomain}"
def gcpNomadToken = System.getenv("NOMAD_TOKEN") ?: ""
def gcpMinioEndpoint = System.getenv("NF_MINIO_ENDPOINT") ?: "https://minio.${gcpDomain}"
def gcpWorkDir = "/work/nextflow-work"
def gcpOutputDir = System.getenv("NF_OUTPUT_DIR") ?: "s3://user-output/nextflow"
def awsAccessKey = System.getenv("AWS_ACCESS_KEY_ID") ?: secrets.AWS_ACCESS_KEY_ID
def awsSecretKey = System.getenv("AWS_SECRET_ACCESS_KEY") ?: secrets.AWS_SECRET_ACCESS_KEY

plugins {
    id "nf-nomad@${System.getenv("NOMAD_PLUGIN_VERSION") ?: "99.99.99"}"
    id "nf-rclone@${System.getenv("RCLONE_PLUGIN_VERSION") ?: "99.99.99"}"
}

docker {
    enabled = true
}

process {
    executor = "nomad"
    errorStrategy = "retry"
    maxRetries = 1
}

workDir = System.getenv("NXF_WORK_DIR") ?: "s3://work/nextflow-work"

aws {
    // Prefer env creds injected from Nomad Variables; keep secrets fallback.
    accessKey = awsAccessKey
    secretKey = awsSecretKey
    client {
        endpoint = gcpMinioEndpoint
        s3PathStyleAccess = true
        protocol = "https"
    }
}

nomad {
    client {
        address = gcpNomadAddr
        // Keep token bootstrap via env; secrets lookup itself needs Nomad API auth
        token = gcpNomadToken
        pollInterval = "2s"
        submitThrottle = "100ms"
    }

    jobs {
        namespace = "default"
        deleteOnCompletion = false
        cpuMode = "cores"
        failOnPlacementFailure = true
        placementFailureTimeout = "5m"
        meta = [env: "gcp", launcher: "head-job", stack: "nomad-cluster"]
        volumes = [[type: "host", name: "nextflow-work", path: "/work/nextflow-work"]]
        failures = [
            restart   : [attempts: 1, mode: "fail"],
            reschedule: [attempts: 1]
        ]
        secrets {
            enabled = true
            path = "secrets/nf-nomad"
        }
    }
}

rclone {
    enabled = true
    remotes {
        'gcp-minio' {
            type            = 's3'
            provider        = 'Minio'
            endpoint        = gcpMinioEndpoint
            accessKeyId     = awsAccessKey
            secretAccessKey = awsSecretKey
        }
    }
    pathMapping = [
        's3://work'       : 'gcp-minio',
        's3://user-input' : 'gcp-minio',
        's3://user-output': 'gcp-minio'
    ]
    rcloneWorkDir {
        enabled      = true
        remote       = 'gcp-minio'
        remotePath   = 'work/nextflow-work'
        configDelivery = 'hostPath'
        syncBack     = 'all'
        legalTransfer {
            enabled = (System.getenv("LEGAL_TRANSFER_ENABLED") ?: "false").toBoolean()
            policyServiceUrl = System.getenv("LEGAL_TRANSFER_POLICY_URL") ?: "http://127.0.0.1:8080/v1/transfer/validate"
            failOpen = (System.getenv("LEGAL_TRANSFER_FAIL_OPEN") ?: "true").toBoolean()
            timeoutMillis = (System.getenv("LEGAL_TRANSFER_TIMEOUT_MS") ?: "5000") as int
        }
    }
}

profiles {
    hello {
        params {
            outdir = "${gcpOutputDir}/hello"
        }
        process {
            cpus = 1
            memory = "1 GB"
            time = "30m"
        }
    }
}
