plugins {
    id "nf-nomad@0.4.0-edge2"
}


//workDir = "s3://fusionfs/work"

tower {
    enabled = false
}

process {
    executor = "nomad"
}

docker {
    enabled = true
}

aws {
    client {
        endpoint = 'http://84.8.141.219:9000'
        s3PathStyleAccess = true
        protocol = "http"
    }
    accessKey = 'TUIe4l4qklLa'
    secretKey = 'KoEjVCovFTTJpfdaoI6PDzkY5H3cvzNV'
}


wave.enabled=true
fusion.enabled=true
fusion.exportStorageCredentials=true


nomad {

    client {
        address = "http://84.8.141.219:4646"
        token = System.getenv("NOMAD_TOKEN")   // never commit a literal ACL token
    }

    jobs {

        deleteOnCompletion = false


        constraints = {
                    node {
                        unique = [ name: 'nomad-client-1' ]
                    }
                }
    }

}
