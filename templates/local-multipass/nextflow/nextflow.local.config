plugins {
    id "nf-nomad@0.4.0-edge2"
}


process {
    executor = "nomad"
}

// nf-nomad-dev workspace
tower {
    workspaceId = "276172789442513"

}

docker {
    enabled = true
}


workDir = "$PWD/work/"


nomad {

    // debug = true

    client {
        address = "http://localhost:4646"
    }

    jobs {

        // namespace = 'nf-nomad'

        deleteOnCompletion = false

        volumes = [{ type "host" name "work" path "$PWD/work/" },
                   { type "host" name "dothome_nextflow" path "$HOME/.nextflow/" }]

    }

}
