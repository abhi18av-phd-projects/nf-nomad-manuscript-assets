plugins {
    id "nf-nomad@0.4.0-edge2"
}


workDir = "s3://fusionfs/work"

tower {
    enabled = false
}

process {
    executor = "nomad"
}

docker {
    enabled = true
}

aws {
    accessKey = '1MANDYvT7Y4O4s0LilNm'
    secretKey = 'zUUQ36aPwZKJwFy2dZiZTQGJLlakWF0mABxB17KM'

    client {
      endpoint = "http://<NOMAD_NODE_TAILNET_IP>:9000"
      s3PathStyleAccess = true
      protocal = "http"
    }
}


wave.enabled=true
fusion.enabled=true
fusion.exportStorageCredentials=true


nomad {

    client {
        address = "http://<NOMAD_NODE_TAILNET_IP>:4646"
        token = ""
    }

    jobs {

        datacenters = "sun-nomadlab"

        namespace = "nf-nomad"

        deleteOnCompletion = false
    }

}
